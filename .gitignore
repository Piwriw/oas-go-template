# Binaries
/bin/
/dist/
# Bare `go build ./cmd/server` from repo root drops a `server` binary in . —
# use `make build` to put it under bin/.
/server
# Ignore client binaries left by earlier template versions.
/client
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go test / build artifacts
*.test
*.out
coverage.txt
coverage.html

# Generated Go code (kept tracked, but in case we add anything transient)
# Note: *.gen.go files ARE tracked; do not ignore them.

# Dependency directories
/vendor/

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Environment files
.env
.env.local
.env.*.local

# Local config (real values, often with secrets; commit only config.example.yaml)
/config.yaml

# Node (web/)
node_modules/
web/dist/
web/.vite/

# Air live-reload tmp
/tmp/
docs/superpowers

# OS
Thumbs.db
